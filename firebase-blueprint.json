{
  "entities": {
    "Class": {
      "title": "Class",
      "description": "A classroom group created by a teacher",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the class" },
        "teacherId": { "type": "string", "description": "UID of the teacher who owns this class" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["name", "teacherId", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "A student within a class",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the student" },
        "classId": { "type": "string", "description": "ID of the class this student belongs to" },
        "wallet_points": { "type": "number", "description": "Points earned by the student" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "avatarConfig": {
          "type": "object",
          "properties": {
            "style": { "type": "string" },
            "seed": { "type": "string" },
            "backgroundColor": { "type": "string" }
          }
        },
        "inventory": {
          "type": "object",
          "properties": {
            "unlockedStyles": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["name", "classId", "wallet_points", "createdAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "A folder to organize quizzes",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the folder" },
        "teacherId": { "type": "string", "description": "UID of the teacher who owns this folder" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["name", "teacherId", "createdAt"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A set of questions created by a teacher",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the quiz" },
        "description": { "type": "string", "description": "Description of the quiz" },
        "teacherId": { "type": "string", "description": "UID of the teacher who owns this quiz" },
        "folderId": { "type": "string", "description": "ID of the folder this quiz belongs to" },
        "questions": { "type": "array", "description": "List of questions" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["title", "teacherId", "questions", "createdAt"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "A live or homework game session",
      "type": "object",
      "properties": {
        "pin": { "type": "string", "description": "Access code for the session" },
        "quizId": { "type": "string", "description": "ID of the quiz being played" },
        "hostId": { "type": "string", "description": "UID of the teacher hosting the session" },
        "status": { "type": "string", "description": "Current status of the game" },
        "players": { "type": "array", "description": "List of players in the session" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "mode": { "type": "string", "description": "LIVE or HOMEWORK" },
        "homeworkConfig": { "type": "object", "description": "Configuration for homework mode" },
        "settings": {
          "type": "object",
          "properties": {
            "effectDuration": { "type": "number", "description": "Duration of item effects in seconds" }
          }
        }
      },
      "required": ["pin", "quizId", "hostId", "status", "players", "createdAt"]
    },
    "StudentGroup": {
      "title": "StudentGroup",
      "description": "A group of students within a class",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the group" },
        "classId": { "type": "string", "description": "ID of the class this group belongs to" },
        "studentIds": { "type": "array", "items": { "type": "string" }, "description": "List of student IDs in this group" },
        "points": { "type": "number", "description": "Points earned by the group" },
        "teacherId": { "type": "string", "description": "UID of the teacher who created this group" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["name", "classId", "studentIds", "points", "teacherId", "createdAt"]
    },
    "ClassSession": {
      "title": "ClassSession",
      "description": "A live class session",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "ID of the class" },
        "teacherId": { "type": "string", "description": "UID of the teacher" },
        "startTime": { "type": "number", "description": "Timestamp of start time" },
        "endTime": { "type": "number", "description": "Timestamp of end time" },
        "status": { "type": "string", "description": "Status of the session" },
        "events": { "type": "array", "description": "List of point events" }
      },
      "required": ["classId", "teacherId", "startTime", "status", "events"]
    },
    "ShopItem": {
      "title": "ShopItem",
      "description": "An item in the shop",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Type of the item" },
        "name": { "type": "string", "description": "Name of the item" },
        "price": { "type": "number", "description": "Price of the item" },
        "config": { "type": "object", "description": "Configuration for the item" },
        "requiredLevel": { "type": "number", "description": "Required level to purchase" },
        "imageUrl": { "type": "string", "description": "URL of the item image" }
      },
      "required": ["type", "name", "price", "config", "requiredLevel", "imageUrl"]
    },
    "ShowcaseImage": {
      "title": "ShowcaseImage",
      "description": "An image captured for student work showcase",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "description": "UID of the teacher who captured the image" },
        "imageUrl": { "type": "string", "description": "Base64 encoded image data" },
        "status": { "type": "string", "description": "Status of the image (gallery, projecting, comparing)" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["teacherId", "imageUrl", "status", "createdAt"]
    }
  },
  "firestore": {
    "/classes": { "schema": "Class", "description": "Collection of classes" },
    "/students": { "schema": "Student", "description": "Collection of students" },
    "/folders": { "schema": "Folder", "description": "Collection of folders" },
    "/quizzes": { "schema": "Quiz", "description": "Collection of quizzes" },
    "/sessions": { "schema": "GameSession", "description": "Collection of game sessions" },
    "/groups": { "schema": "StudentGroup", "description": "Collection of student groups" },
    "/classSessions": { "schema": "ClassSession", "description": "Collection of class sessions" },
    "/shop_items": { "schema": "ShopItem", "description": "Collection of shop items" },
    "/showcase_images": { "schema": "ShowcaseImage", "description": "Collection of showcase images" }
  }
}
